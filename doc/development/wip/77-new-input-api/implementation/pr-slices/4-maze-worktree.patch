+-- need_reopen/reopen_text carry an invalid submit's text to
+-- the NEXT tick — show() ignores a re-entrant call made from
+-- inside on_text_entered (submit() still holds the overlay
+-- open at that point, then unconditionally hides it right
+-- after), so the reshow-with-invalid-text must be deferred
+-- one frame rather than issued synchronously (M5c-05).
+--
+-- rearm_input's shown-guard reads love.state.user_input
+-- directly rather than a shadow boolean: hide() (called by
+-- BOTH submit() and cancel(), userInputController.lua:158-
+-- 161, 276-278) unconditionally nils it, so it is truthy
+-- exactly while the overlay is shown, on every dismiss path.
+-- A shadow boolean cleared only on submit desyncs on cancel
+-- (framework escape -> ui:cancel() -> hide(), no maze
+-- callback) and permanently disables the editor (M5c-05
+-- corrective; see reviews/M5c-05.md).
+need_reopen = false
+reopen_text = nil
+
+function open_editor_input(text)
+  need_reopen = false
+  compy.input.show{
+    prompt = "Commands:",
+    text = text,
+    on_text_entered = handle_editor_submit,
+  }
 end
 
