+function handle_editor_submit(text)
   local lines = string.lines(text)
   local offset = #echo_lines
   if process_input(lines, offset) then
     record_echo(lines)
   else
     sfx.wrong()
-    input_text("Commands:", string.lines(text))
+    need_reopen = true
+    reopen_text = text
+  end
+end
+
+function rearm_input()
+  if love.state.user_input then
+    return
+  end
+  if need_reopen then
+    open_editor_input(reopen_text)
+  elseif not player.anim and #(player.queue) == 0 then
+    open_editor_input()
   end
 end
 
