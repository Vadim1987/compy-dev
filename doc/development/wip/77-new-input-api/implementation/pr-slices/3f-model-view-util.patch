+  mod_triples = mod_triples,
+  normalize_combo = normalize_combo,
+  new_handler_table = new_handler_table,
+  is_enter    = is_enter,
+  any_pressed = any_pressed,
+  is_mod      = is_mod,
+  shift       = shift,
+  is_shift    = is_shift,
+  ctrl        = ctrl,
