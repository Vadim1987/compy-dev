+  -- the prompt would re-trigger show (which warns and no-ops).
+  if key == "i" and not compy.input.is_shown() then
+    compy.input.show{
+      prompt = "TURTLE",
+      on_text_entered = function(lines)
+        eval(lines[1])
+      end,
+    }
+    return true
   end
 
