+-- The device question behind each modifier row. Key exports one
+-- helper per generic name and each folds its own l/r pair, so a
+-- row is answered by one call rather than two lookups.
+local MOD_HELD = {
+  ctrl  = Key.ctrl,
+  alt   = Key.alt,
+  shift = Key.shift,
