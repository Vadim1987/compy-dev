From 56347d01f4eb60a60dc107d3837279e766e49c69 Mon Sep 17 00:00:00 2001
From: Hleb Rubanau <g.rubanau@gmail.com>
Date: Sun, 12 Jul 2026 13:49:19 +0000
Subject: [PATCH] feat: migrate off legacy poll idiom onto compy.input.*
 continuous-session API

Replaces the user_input()/input_text() poll-a-reftable loop with the
compy.input.* continuous-session idiom: activate once via show{}, deliver
submits through on_text_entered (routed to the game state handler), re-arm
via a field-write after_submit, and set the per-hint prompt live with
compy.input.configure{prompt=...}. The per-frame terminal_read poll and the
per-hint input_text re-show are gone.

Part of compy feat/77 (new input API), milestone M8-02. Delivered as an
unpushed local commit in this detached checkout per the compy maintainer's
authorization; the pre-existing uncommitted main.lua test-comment cruft is
deliberately excluded (left as working-tree changes).

Co-Authored-By: Claude Opus 4.8 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01P5YeUrESzsiSRRKJ28aiQ3
---
 main.lua     |  2 +-
 terminal.lua | 28 +++++++++++++++++-----------
 ui.lua       |  3 ---
 3 files changed, 18 insertions(+), 15 deletions(-)

diff --git a/main.lua b/main.lua
index aa5af59..0cd4dd5 100644
--- a/main.lua
+++ b/main.lua
@@ -93,8 +93,8 @@ function game_init()
 
   local state_updater = game_state_router(on_tick)
   local input_handler = game_state_router(on_input)
+  terminal_set_handler(input_handler)
   hooks.update = function(...)
-    ui_read_input(input_handler)
     state_updater(...)
   end
   hooks.draw = game_state_router(ui_renderers)
diff --git a/terminal.lua b/terminal.lua
index 5e0368a..163da52 100644
--- a/terminal.lua
+++ b/terminal.lua
@@ -1,25 +1,31 @@
 require("helpers")
 require("debugfunc")
 
-terminal = nil -- not initialied by default
+-- Deferred until game_init() builds the real router (ui.lua
+-- requires this file, and therefore activates the session,
+-- before main.lua's game_state_router exists).
+local current_handler = noop
 
-function terminal_read(callback)
-  callback = callback or noop
-  if not terminal:is_empty() then
-    local msg = terminal()
-    callback(msg)
-    return msg
-  end
+local function deliver(text)
+  current_handler(text)
+end
+
+function terminal_set_handler(handler)
+  current_handler = handler
 end
 
 function terminal_write(msg, flushed)
-  input_text(msg, nil)
+  compy.input.configure({ prompt = msg })
 end
 
+-- Continuous-session idiom: activate once; each submit re-arms
+-- via after_submit (bare show(), prompt stays model-sticky).
 function terminal_init()
-  terminal = user_input()
+  compy.input.after_submit = function()
+    compy.input.show({})
+  end
+  compy.input.show({ on_text_entered = deliver })
   return {
     write = terminal_write,
-    read = terminal_read,
   }
 end
diff --git a/ui.lua b/ui.lua
index eb82042..dc00b9d 100644
--- a/ui.lua
+++ b/ui.lua
@@ -80,9 +80,6 @@ function ui_draw_status()
   ui.status_bar.draw(status)
 end
 
--- alias
-ui_read_input = terminal_read
-
 ui_renderers = action_map({
   loaded = ui.splash_welcome.draw,
   active = function()
