-function terminal_read(callback)
-  callback = callback or noop
-  if not terminal:is_empty() then
-    local msg = terminal()
-    callback(msg)
-    return msg
-  end
+-- on_text_entered delivers the submitted LINES, an array of
+-- strings (Compy Input API, "Quick start"). The game's handlers
+-- take one command string — game_commands[txt] indexes by it —
+-- which is what the retired poll idiom handed them, so join
+-- here rather than teaching every state handler about lines.
+local function deliver(lines)
+  current_handler(string.unlines(lines))
+end
+
+function terminal_set_handler(handler)
+  current_handler = handler
 end
 
 function terminal_write(msg, flushed)
-  input_text(msg, nil)
+  compy.input.configure({ prompt = msg })
 end
 
+-- Continuous-session idiom: activate once and stay open. Each
+-- submit clears the line for the next command; the widget stays
+-- open by default (no re-show needed). ESC also clears and stays
+-- open by default, so the command line can't be dismissed with no
+-- way back — nothing to re-arm.
 function terminal_init()
-  terminal = user_input()
+  compy.input.callbacks.after_submit = function()
+    compy.input.clear()
+  end
+  compy.input.show({ on_text_entered = deliver })
   return {
     write = terminal_write,
-    read = terminal_read,
   }
 end
