+--- @param model UserInputModel
+--- @param validator function?
+--- @param text string
+--- @return boolean ok
+local function gate(model, validator, text)
+  if not validator then return true end
+  local ok, err = validator(text)
+  if not ok then model:set_error({ err }) end
+  return ok
+end
+
