+  -- { M, C, V } handle the legacy poll idiom reads. Drivers
+  -- change but the flag persists (doc/development/internals/user_input.md,
+  -- "Widget lifecycle").
+  love.state.user_input = {
+    M = self.model,
+    C = self,
+    V = self.view,
+  }
