+    ev.highlighter = cfg.highlighter
+  end
+  if cfg.validator ~= nil then
+    self.validator = cfg.validator
+  end
+  if cfg.on_text_entered ~= nil then
+    self.on_text_entered = cfg.on_text_entered
+  end
