+      function()
+        local seen  = { }
+        local input = F.activate_project()
+        local step  = function(who)
+          return function(k, sc, isr)
+            seen[who] = { k, sc, isr }
+          end
+        end
+        input.shortcuts.keypressed['a'] = step('shortcut')
+        input.hooks.keypressed         = step('hook')
