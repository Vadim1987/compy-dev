 --- @alias EditorMode
 --- | 'edit' --- default
---- | 'nav' --- display-only, 'edit' with editing off
+--- | 'nav' --- navigating between blocks
 --- | 'reorder'
 --- | 'search'
 
@@ -37,7 +36,6 @@ end
